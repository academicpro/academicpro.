PORT=3000
SITE_URL=http://localhost:3000

# PayPal Developer credentials: use sandbox credentials while testing.
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox

# Set a strong password before exposing the admin dashboard publicly.
ADMIN_PASSWORD=change-this-to-a-long-random-password

# Optional contact details shown on the website
CONTACT_EMAIL=hello@yourdomain.com
WHATSAPP_NUMBER=
